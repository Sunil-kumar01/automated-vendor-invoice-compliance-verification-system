# Copy these settings into Streamlit Community Cloud > App settings > Secrets.
AI_PROVIDER = "openai_compatible"
AI_MODEL = "your-provider-model-name"
OPENAI_BASE_URL = "https://your-provider.example/v1"
OPENAI_API_KEY = "paste-your-secret-key-here"

# For local Ollama instead, use:
# AI_PROVIDER = "ollama"
# AI_MODEL = "qwen2.5"
# OLLAMA_URL = "http://localhost:11434/api/generate"
